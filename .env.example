# GET POSTED AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!

# Supabase
SUPABASE_URL=https://lpmpcprejxmgeuxdhlsj.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# OpenAI (ChatGPT)
OPENAI_KEY=sk-your-openai-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_STARTER=price_your-price-id
STRIPE_PRICE_PRO=price_your-price-id
STRIPE_PRICE_ENTERPRISE=price_your-price-id

# RunPod Serverless GPU (for video/image/voice generation)
# Get keys from: https://www.runpod.io/console/console/settings
RUNPOD_API_KEY=rpa_your-key-here
RUNPOD_VIDEO_KEY=rpa_your-video-key-here
RUNPOD_IMAGE_KEY=rpa_your-image-key-here
RUNPOD_VOICE_KEY=rpa_your-voice-key-here

# RunPod Endpoint IDs (after deploying from Hub)
RUNPOD_VIDEO_ENDPOINT=your-wan21-endpoint-id
RUNPOD_IMAGE_ENDPOINT=your-flux-endpoint-id
RUNPOD_VOICE_ENDPOINT=your-xtts-endpoint-id

# Client-side RunPod keys (for direct fallback)
VITE_RUNPOD_VIDEO_KEY=rpa_your-video-key-here
VITE_RUNPOD_IMAGE_KEY=rpa_your-image-key-here
VITE_RUNPOD_VOICE_KEY=rpa_your-voice-key-here

# Server
PORT=4002
