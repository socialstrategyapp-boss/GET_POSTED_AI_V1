# GET POSTED AI - Environment Variables Template
# Copy to .env and fill in values. NEVER commit .env to GitHub!

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://lpmpcprejxmgeuxdhlsj.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ─── OpenAI Service Keys (3 total) ───────────────────────────────────────────
# Use for Edge Functions — higher rate limits, more reliable
OPENAI_KEY=sk-svcacct-your-key-1
OPENAI_KEY_2=sk-svcacct-your-key-2
OPENAI_KEY_3=sk-svcacct-your-key-3

# ─── OpenAI User Keys (2 total) ──────────────────────────────────────────────
# Personal keys — fallback if service keys fail
OPENAI_USER_KEY_1=sk-proj-your-key-1
OPENAI_USER_KEY_2=sk-proj-your-key-2

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# ─── Moonshot AI (2 keys) ────────────────────────────────────────────────────
# From: https://platform.moonshot.cn
MOONSHOT_KEY_1=your-moonshot-key-1
MOONSHOT_KEY_2=your-moonshot-key-2

# ─── RunPod API Keys (3 keys) ────────────────────────────────────────────────
# From: https://www.runpod.io/console/settings
RUNPOD_KEY_1=rpa_your-key-1
RUNPOD_KEY_2=rpa_your-key-2
RUNPOD_KEY_3=rpa_your-key-3

# RunPod Serverless Endpoint IDs (fill after deploying templates from Hub)
RUNPOD_VIDEO_ENDPOINT=your-wan21-endpoint-id
RUNPOD_IMAGE_ENDPOINT=your-flux-endpoint-id
RUNPOD_VOICE_ENDPOINT=your-xtts-endpoint-id

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_STARTER=price_your-price-id
STRIPE_PRICE_PRO=price_your-price-id
STRIPE_PRICE_ENTERPRISE=price_your-price-id

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4002
